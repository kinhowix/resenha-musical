# Copie este arquivo para .env e preencha com os dados do seu projeto no Console do Firebase
# Enquanto estiver vazio, o app funciona automaticamente em Modo Local (LocalStorage)!

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

